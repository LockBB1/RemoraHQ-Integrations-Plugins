# RemoraHQ Integrations plugin — server-side secrets
# Copy this file to .env in the same directory and fill the values.
# The plugin reads .env on startup (no dotenv dep), then falls back to
# whatever process.env was set before MeshCentral started (systemd
# EnvironmentFile, PowerShell $env:, etc).

# Jira API token / personal access token.
# - Jira Cloud: this is the API token from https://id.atlassian.com/manage-profile/security/api-tokens
#   AND you must also set JIRA_EMAIL below, since Cloud uses Basic auth (email:token).
# - Jira Server / Data Center with Personal Access Tokens: just set JIRA_API_KEY; leave JIRA_EMAIL empty.
JIRA_API_KEY=

# Optional. Set only for Jira Cloud Basic auth.
JIRA_EMAIL=
